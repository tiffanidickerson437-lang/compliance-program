{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tiffanidickerson437-lang/compliance-program/.claude/skills/draft-narrative/templates/oscal-control.schema.json",
  "title": "Owned OSCAL control entry",
  "description": "The shape of one control object in 02-controls/control-library.oscal.json (OSCAL catalog, catalog.controls[]). Derived from the committed file; any drafted or edited control entry must match this shape. Narratives quote the 'statement' part verbatim.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Lowercase OSCAL control id, e.g. aat-01 or pri-03.13.1 for a nested enhancement.",
      "pattern": "^[a-z]{3}-[0-9]{2}(\\.[0-9]+)*$"
    },
    "class": {
      "type": "string",
      "description": "Control class; the owned library uses SCF."
    },
    "title": {
      "type": "string"
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "guidelines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "prose": { "type": "string" } },
              "required": ["prose"]
            }
          },
          "values": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "label"]
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Prop names used by the committed library: scf-id, scf-domain, nist-csf-function, automation, hero-control."
          },
          "ns": { "type": "string", "format": "uri" },
          "value": { "type": "string" }
        },
        "required": ["name", "value"]
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": {
            "type": "string",
            "description": "Part names used by the committed library.",
            "enum": ["statement", "guidance", "assessment-objective", "assessment-method"]
          },
          "prose": { "type": "string" },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "ns": { "type": "string" },
                "value": { "type": "string" }
              },
              "required": ["name", "value"]
            }
          },
          "parts": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "required": ["name"]
      }
    },
    "controls": {
      "type": "array",
      "description": "Nested enhancement controls, same shape as the parent.",
      "items": { "$ref": "#" }
    }
  },
  "required": ["id", "title", "class"],
  "additionalProperties": false
}
